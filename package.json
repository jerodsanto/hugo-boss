{
  "name": "hugo-boss",
  "version": "1.0.0",
  "description": "Preview, publish, and deploy your Hugo blog without leaving your editor.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "hugo",
    "blog",
    "publishing"
  ],
  "author": "Jerod Santo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jerodsanto/hugo-boss"
  },
  "devDependencies": {
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "typescript": "4.7.4"
  }
}
